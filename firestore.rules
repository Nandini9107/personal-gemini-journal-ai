rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      match /entries/{entryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(entryId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      match /chats/{chatId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(chatId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(chatId);
      }
    }
  }
}
